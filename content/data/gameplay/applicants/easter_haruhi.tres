script = ExtResource("1")
applicant_name = "凉宫春日"
gender = "女"
age = 16
profession = "高中生"
profession_description = "县立北高在读学生，非官方社团SOS团创立者及实际控制人。经多方秘密机构评估，该个体具备无意识改变现实的极度危险能力。当前无独立经济能力，其行为模式具有极高的不可预测性。"
