[sub_resource type="Resource" id="debt_medical"]
script = ExtResource("2_debt")
category = "医疗"
display_name = "医疗欠款"
description = "因疾病或伤害产生的医疗费用欠款。通常属于被动负债，不一定反映财务管理能力。"
debt_ratio_min = 0.3
debt_ratio_max = 0.8
overdue_chance = 0.2

[sub_resource type="Resource" id="debt_education"]
script = ExtResource("2_debt")
category = "教育"
display_name = "教育贷款"
description = "为接受教育或培训产生的贷款。属于投资性负债，可能带来未来收入增长。"
debt_ratio_max = 0.4
overdue_chance = 0.05
settled_chance = 0.2

[sub_resource type="Resource" id="debt_mortgage"]
script = ExtResource("2_debt")
category = "房贷"
display_name = "房贷"
description = "购买住房产生的按揭贷款。属于常见的长期负债，通常有不动产作为抵押。"
debt_ratio_min = 0.5
debt_ratio_max = 1.5
overdue_chance = 0.05
settled_chance = 0.05

[sub_resource type="Resource" id="debt_consumer"]
script = ExtResource("2_debt")
category = "消费贷"
display_name = "消费贷"
description = "用于日常消费的贷款。频繁的消费贷可能暗示入不敷出的财务状况。"
overdue_chance = 0.15

[sub_resource type="Resource" id="debt_gambling"]
script = ExtResource("2_debt")
category = "赌博"
display_name = "赌场借贷"
description = "因赌博产生的债务。[color=#ff6b6b]高风险信号[/color]，严重影响还款意愿和能力。"
debt_ratio_min = 0.2
debt_ratio_max = 1.0
overdue_chance = 0.4
settled_chance = 0.05

[sub_resource type="Resource" id="debt_business"]
script = ExtResource("2_debt")
category = "商业"
display_name = "商业贷款"
description = "经营活动中产生的商业贷款。属于生产性负债，需结合经营状况综合判断。"
debt_ratio_min = 0.3
debt_ratio_max = 0.8
settled_chance = 0.15

[sub_resource type="Resource" id="asset_housing"]
script = ExtResource("5_asset")
category = "住房"
display_name = "自有住房"
description = "申请者名下的不动产。拥有住房通常意味着较强的经济基础和稳定性，是重要的还款保障。"
value_min = 30000
value_max = 100000
is_housing = true

[sub_resource type="Resource" id="asset_savings"]
script = ExtResource("5_asset")
category = "存款"
display_name = "定期存款"
description = "申请者在殖民地银行中的现金储蓄。流动性最强的资产，是最直接的还款来源。"
value_max = 30000

