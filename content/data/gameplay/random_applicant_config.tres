[resource]
script = ExtResource("1")
first_names_male = PackedStringArray("杰克", "马库斯", "亚当", "诺亚", "伊桑", "卢卡斯", "奥利弗", "丹尼尔", "塞缪尔", "亨利")
first_names_female = PackedStringArray("莉娜", "艾琳", "索菲亚", "艾玛", "米娅", "奥利维亚", "夏洛特", "阿梅莉亚", "伊莎贝拉", "艾娃")
last_names = PackedStringArray("沃克", "张", "莫里森", "陈", "约翰逊", "威廉姆斯", "李", "布朗", "加西亚", "米勒", "戴维斯", "罗德里格斯", "马丁内斯", "赵", "王")
professions = Array[ExtResource("4_prof")]([SubResource("prof_engineer"), SubResource("prof_doctor"), SubResource("prof_merchant"), SubResource("prof_farmer"), SubResource("prof_pilot"), SubResource("prof_nurse"), SubResource("prof_technician"), SubResource("prof_miner"), SubResource("prof_caregiver"), SubResource("prof_unemployed")])
loan_purposes = Array[ExtResource("3_loan")]([SubResource("gp_housing"), SubResource("gp_education"), SubResource("gp_gambling")])
general_assets = Array[ExtResource("5_asset")]([SubResource("asset_housing"), SubResource("asset_savings"), SubResource("asset_ship"), SubResource("asset_equipment"), SubResource("asset_livestock"), SubResource("asset_shop")])
debt_templates = Array[ExtResource("2_debt")]([SubResource("debt_medical"), SubResource("debt_education"), SubResource("debt_mortgage"), SubResource("debt_consumer"), SubResource("debt_gambling"), SubResource("debt_business")])
residence_location_modifiers = PackedFloat32Array(0.03, 0.01, 0, -0.01, -0.03)
residence_location_descriptions = PackedStringArray("殖民地的核心区域，基础设施完善，治安良好。居住成本最高，居民经济条件普遍较好。", "围绕星际港口发展的区域，商业繁荣，人口流动性大。居住成本较高，就业机会多。", "殖民地的工业生产区域，工厂和车间密集。居住成本中等，以工人阶层为主。", "靠近矿脉的偏远区域，环境较差。居住成本低，居民多为矿业从业者。", "殖民地边缘的小型定居点，远离核心区域。居住成本最低，治安和基础设施较差。")
residence_type_modifiers = PackedFloat32Array(0.03, 0.01, 0, -0.01, -0.03)
residence_type_descriptions = PackedStringArray("申请者拥有住房产权。表明有一定的资产积累，居住稳定性最高。", "申请者通过贷款购买住房，尚在还款中。有资产但同时承担房贷负债。", "由雇主提供的集体住所。无住房资产，但居住成本低，与就业绑定。", "租赁他人房产居住。无住房资产，每月有固定租金支出。", "借住在亲友处。无住房资产也无租金支出，但居住稳定性最差。")
statement_location_templates = Array[PackedStringArray]([PackedStringArray("住在中央区，生活条件还不错。", "我家在中央区，周围设施挺齐全的。"), PackedStringArray("家在星港区附近，每天看着飞船来来往往。", "住在星港区，人来人往挺热闹的。"), PackedStringArray("住在工业区，周围都是工厂。", "我住工业区，虽然吵了点但离上班近。"), PackedStringArray("住在矿区，离工作的地方近。", "家在矿区，条件差了点但方便。"), PackedStringArray("住在边境镇，虽然偏远但清静。", "我住边境镇，远是远了点但自在。")])
statement_finance_good_templates = PackedStringArray("手头还有些积蓄，经济状况还算宽裕。", "这些年攒了点家底，日子过得去。", "经济上还行，有一定的积蓄。")
statement_finance_normal_templates = PackedStringArray("经济上说不上好也说不上差，就那样吧。", "有点积蓄，也有点欠款，勉强平衡。", "经济状况一般，不好不坏。")
